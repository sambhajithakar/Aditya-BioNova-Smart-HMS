# ---------------------------------------------------------------------------
# Aditya BioNova Smart HMS — environment template
# Copy to .env (git-ignored) and adjust. NEVER commit real secrets.
# Synthetic data only in development. No real patient data, ever.
# ---------------------------------------------------------------------------

# Runtime (non-owner application role — RLS is enforced for this role)
DATABASE_URL=postgresql+psycopg2://hms_app:change_me@127.0.0.1:5433/hms_dev

# Migrations / DDL (table-owner role; never used at request time)
MIGRATION_DATABASE_URL=postgresql+psycopg2://hms:change_me@127.0.0.1:5433/hms_dev

# Auth — generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace_me_with_a_long_random_secret
JWT_ACCESS_TTL_SECONDS=1800
JWT_REFRESH_TTL_SECONDS=1209600

ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Secrets at rest (TOTP seeds). REQUIRED outside development/test:
# python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FIELD_ENCRYPTION_KEY=
# Absolute cap on a login (refresh rotation cannot extend it)
SESSION_ABSOLUTE_TTL_SECONDS=2592000
# Reverse proxies allowed to set X-Forwarded-For (JSON list of IPs/CIDRs)
TRUSTED_PROXIES=["127.0.0.1/32","::1/128"]
# Public web URL used in e-mailed links (password reset, invitations)
WEB_BASE_URL=http://localhost:3000

# Communications — provider-agnostic. "mock" records to the dev outbox and
# contacts nobody. Live providers stay suppressed until COMMS_LIVE_ENABLED=true
# AND credentials are set (requires product-owner approval of cost/contracts).
COMMS_EMAIL_PROVIDER=mock        # mock | brevo
COMMS_SMS_PROVIDER=mock          # mock | dlt_http
COMMS_WHATSAPP_PROVIDER=mock     # mock | meta_cloud
COMMS_LIVE_ENABLED=false
