# Template for infra/docker/.env (git-ignored). Copy, then replace EVERY value.
# Generate each secret with:  python3 -c "import secrets;print(secrets.token_hex(24))"
# (hex keeps them URL-safe — DB passwords are embedded in connection URLs).
HMS_PG_PASSWORD=
HMS_APP_PASSWORD=
JWT_SECRET=
# urlsafe base64 of 32 random bytes (encrypts TOTP seeds at rest)
FIELD_ENCRYPTION_KEY=

# Optional
# HMS_ENVIRONMENT=staging
# CORS_ORIGINS=["https://hms.example.internal"]
# FORWARDED_ALLOW_IPS=172.18.0.0/16
# WEB_API_ORIGIN=http://api:8000     # build-time for the web image
# HMS_PG_HOST_PORT=5432
# HMS_API_HOST_PORT=8000
# HMS_WEB_HOST_PORT=3000
