<?xml version="1.0" encoding="utf-8"?>
<!--
  LAN DEMO BUILD ONLY (flutter build apk with dart-define HMS_DEMO_LAN=true;
  see docs/DEMO.md). app/build.gradle.kts adds this directory to the release
  resources only for that build, so it replaces src/main/res/xml/
  network_security_config.xml there. It permits cleartext HTTP so the phone
  can reach the demo server on the owner's own computer over Wi-Fi. The app
  itself accepts plain http:// only for private LAN addresses
  (lib/demo/demo_server.dart) and refuses servers that report production.
  Synthetic data only. A demo LAN build cannot be signed with the release key.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
