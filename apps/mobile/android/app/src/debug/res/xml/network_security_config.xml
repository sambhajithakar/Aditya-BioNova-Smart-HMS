<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG BUILDS ONLY (resource overlay of src/main/res/xml/
  network_security_config.xml). Local development talks to the API over
  plain HTTP — the emulator host loopback (10.0.2.2), localhost, or a dev
  machine on the LAN — so cleartext is permitted here. Release and profile
  builds never see this file and stay HTTPS-only.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
