<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 6-11 (API 23-30) full-backup rules. android:allowBackup="false" in
  the manifest already disables Auto Backup; these rules are the belt and
  braces for OEM / adb backup paths: NOTHING of this app is backed up.

  Why: the offline store (hms_offline.json) is sealed with an AES key that
  lives in the Android Keystore, and Keystore keys are never backed up. A
  restored file therefore cannot be decrypted on the new device (audit H23 /
  D5), and it holds PHI. Unsynced work must reach the server, not a backup.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
